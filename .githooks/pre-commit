#!/usr/bin/env bash
# ============================================================================
# pre-commit — UM portão só, com as duas metades que existiam antes:
#   1. o da fábrica (preator/adocao/instalar.sh): bloqueia segredo vazado;
#   2. o do projeto (era .husky/pre-commit → scripts/pre-commit.mjs):
#      lint-staged, typecheck, test e knip.
#
# Por que virou um só: o husky aponta `core.hooksPath` para `.husky/_` no
# `prepare`, e a fábrica aponta para `.githooks`. Dois donos do mesmo ponteiro
# significa que o último `pnpm install` decidia qual dos dois portões existia —
# e o perdedor sumia em silêncio, que é o pior jeito de um portão falhar.
# O husky foi removido do projeto; este arquivo é o único pre-commit.
#
# ⚠️ `preator/adocao/instalar.sh` REESCREVE este arquivo (ele o gera do zero no
# passo 4). Se você rodar o instalador de novo, a metade do projeto some daqui:
# o arquivo é versionado, então isso aparece como diff em `git status` —
# confira e restaure com `git checkout .githooks/pre-commit`.
# ============================================================================
set -uo pipefail

RAIZ="$(git rev-parse --show-toplevel)"
cd "$RAIZ" || exit 1

# ---------------------------------------------------------------------------
# 1 · SEGREDO (fábrica) — primeiro por ser o mais barato e o mais grave.
#     Sem a fábrica presente, só esta metade é pulada; as checagens do projeto
#     continuam valendo.
# ---------------------------------------------------------------------------
FAB="$RAIZ/preator"
SCAN="$FAB/esteira/ferramentas/seguranca/segredos.sh"
if [ -f "$SCAN" ]; then
  # Uma chamada sobre o ÍNDICE inteiro (gitleaks, desde a fábrica 2.3.0).
  bash "$SCAN" --staged "$RAIZ"
  rc=$?
  if [ "$rc" -eq 1 ]; then
    echo "[fábrica] BLOQUEADO: segredo detectado no que você está commitando."
    echo "  Tire o valor do arquivo. Se for falso positivo, declare em .gitleaks.toml"
    echo "  — nunca com --no-verify, que apaga o portão em vez do problema."
    exit 1
  fi
  if [ "$rc" -ne 0 ]; then
    echo "[fábrica] BLOQUEADO: não consegui procurar segredo (veja o erro acima)."
    echo "  Isto NÃO é 'está limpo'. Instale o gitleaks: scoop install gitleaks"
    exit 1
  fi
else
  # Submódulo não inicializado. Aviso ALTO em vez de silêncio: quem lê precisa
  # saber que este commit não foi varrido — `git submodule update --init`.
  echo "[fábrica] ⚠️  AVISO: preator/ ausente — NINGUÉM procurou segredo neste commit."
fi

# ---------------------------------------------------------------------------
# 2 · CHECAGENS DO PROJETO — as mesmas quatro, na mesma ordem, que rodavam pelo
#     husky. Todas também estão declaradas no preator-perfil.sh, para que o gate
#     mestre enxergue o que este hook enxerga.
# ---------------------------------------------------------------------------
rodar() {
  "$@" || exit $?
}

rodar pnpm exec lint-staged
# rodar node scripts/lint.mjs --changed
rodar pnpm exec turbo run typecheck --filter=...[HEAD]
rodar pnpm exec turbo run test --filter=...[HEAD]
rodar pnpm knip

exit 0
